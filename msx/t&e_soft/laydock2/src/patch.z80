; Laydock2: Last Attack (c)1988 T&E soft
;
; @author RuRuRu
; @date 2010/08/24 1st Release
; @date 2011/10/13 Support PCM
; @date 2016/08/06 Fix YM2413 initialize
; @date 2026/10/27 Support All PCMs

	cseg
	org	00400h

stack:	equ	0f380h
mdata:	equ	0b800h		; Address of load music data

main:
	di
	im	1
	ld	sp,stack
	call	init
	ei
	jp	loop

loop:
	in	a,(02h)		; Key wait
	or	a
	jr	z,loop

	cp	01h
	jr	nz,stop

	call	0C006h		; stop

	in	a,(03h)
	cp	011h
	jr	nc,play_end
	cp	0ch
	jr	nc,play_pcm

	push	af
	in	a, (07h)
	or	a
	call	nz,0C302h	; init(opll)
	pop	af

	di
	out	(03h),a		; Load data to memory
	ei

	ld	a, 04h
	call	0C003h

	jr	loop

play_pcm:
	sub	0ch
	ld	e,a
	ld	d,0
	ld	hl,pcm_end
	add	hl,de
	ld	c,(hl)
	ld	hl,pcm_wait
	add	hl,de
	ld	b,(hl)
	di
	out	(04h),a
	ld	a,c
	ld	(0A8DEh),a	; Set end-page
	ld	a,b
	ld	(0A8EAh),a	; Change PSG sample wait

	call	0A825h		; PCM play

	di
	ld	a,8
	out	(0A0h),a
	xor	a
	out	(0A1h),a
	ei
	jr	play_end


stop:
	ld	b, 0Ah
	call	0C009h		; fade out

play_end:
	xor	a		; Change hoot status
	out	(02h),a
	jr	loop

init:
	ld	a, 0c3h
	ld	(0FD9Fh), a
	ld	hl, irq
	ld	(0FDA0h), hl

	ld	a, 0C9h
	ld	(0D006h), a

	ld	a, 0ah
	ld	(0A8EAh), a

	in	a, (07h)
	or	a
	jr	z, devpsg
	call	0C302h
	ret
devpsg:
	call	0C000h
	ret

irq:
	call	0C00Fh
	ret

pcm_end:
	db	070h,05fh,06ch,076h,04ah

pcm_wait:	; Original Wait : 08h
	db	00ah,00ah,00ah,00ah,00ah
