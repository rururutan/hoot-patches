; 信長の野望・全国版 for X1 (c)Koei
; メインルーチン

	org	0f000h
	di
	ld	sp,0fd00h
	ld	a,001h
	ld	(0af71h),a
	call	stop

	ld	hl,irq
	ld	(0fe06h),hl
	ld	a,0feh
	ld	i,a
	im	2
	ld	bc,01fa0h
	xor	a
	out	(c),a
	ld	a,007h
	out	(c),a
	ld	a,0fah
	out	(c),a
	ld	bc,01fa3h
	ld	a,0c7h
	out	(c),a
	ld	a,014h
	out	(c),a
	ei
idle:
	ld	bc,00000h
	in	a,(c)
	or	a
	jp	z,idle
music_select:
	di
	ld	sp,0fd00h
	call	stop
	ld	bc,00000h
	in	a,(c)
	cp	001h
	jp	nz,skip
	inc	c
	in	a,(c)
	cp	003h
	jp	nc,skip
	ld	(selected),a
	ld	a,0ffh
	out	(c),a
	ld	hl,initial_data
	ld	de,0615eh
	ld	bc,0001ah
	ldir
	ei

	ld	hl,00000h
	push	hl
	ld	a,(selected)
	cp	001h
	jr	z,ending
	cp	002h
	jr	z,game_over
	ld	hl,04504h
	ld	de,045f0h
	ld	bc,046a2h
	jr	music_start
ending:
	ld	hl,08000h
	ld	de,08039h
	ld	bc,08070h
	jr	music_start
game_over:
	ld	hl,08100h
	ld	de,08128h
	ld	bc,08148h
music_start:
	call	05f3eh
	pop	bc
	call	stop
	jp	idle
skip:
	ld	bc,00001h
	ld	a,0ffh
	out	(c),a
	ei
	jp	idle
stop:
	ld	a,007h
	ld	e,0ffh
	call	write_psg
	ld	a,008h
	ld	e,000h
	call	write_psg
	inc	a
	call	write_psg
	inc	a
	call	write_psg
	ret
write_psg:
	push	af
	push	bc
	ld	bc,01c00h
	out	(c),a
	dec	b
	ld	a,e
	out	(c),a
	pop	bc
	pop	af
	ret
irq:
	push	af
	push	bc
	ld	bc,00000h
	in	a,(c)
	or	a
	jr	nz,abort_play
	pop	bc
	pop	af
	ei
	reti
abort_play:
	ld	sp,0fd00h
	ld	hl,music_select
	push	hl
	ei
	reti
selected:
	db	000h
initial_data:
	db	001h,000h,000h,000h,000h,000h,000h,000h
	db	000h,000h,000h,000h,000h,000h,003h,003h
	db	003h,008h,008h,008h,000h,002h,004h,00fh
	db	00fh,00fh
